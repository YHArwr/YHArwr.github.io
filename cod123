<title>MW4 迷彩任务勾选清单（含 DMZ）</title>
<style>
  :root{
    --bg:#0f1419; --panel:#1a212b; --panel2:#222c38; --line:#2c3744;
    --txt:#e6edf3; --sub:#9fb0c0; --accent:#ff7a45; --accent2:#4ea1ff;
    --dmz:#ffb347; --ok:#3fb950; --warn:#f0883e; --chip:#2c3744;
  }
  *{box-sizing:border-box}
  body{margin:0;background:var(--bg);color:var(--txt);
    font-family:-apple-system,BlinkMacSystemFont,"Segoe UI","PingFang SC","Microsoft YaHei",sans-serif;
    font-size:14px;line-height:1.5}
  header{position:sticky;top:0;z-index:20;background:linear-gradient(180deg,#11161d,#0f1419);
    border-bottom:1px solid var(--line);padding:14px 18px}
  h1{font-size:18px;margin:0 0 4px}
  .sub{color:var(--sub);font-size:12px;margin-bottom:10px}
  .barwrap{background:var(--panel2);border:1px solid var(--line);border-radius:8px;height:22px;overflow:hidden;position:relative}
  .bar{height:100%;width:0;background:linear-gradient(90deg,var(--accent),#ffa56b);transition:width .25s}
  .barlabel{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:600}
  .controls{display:flex;flex-wrap:wrap;gap:8px;margin-top:12px;align-items:center}
  input[type=text]{background:var(--panel);border:1px solid var(--line);color:var(--txt);
    border-radius:6px;padding:6px 10px;min-width:200px}
  button{background:var(--panel2);border:1px solid var(--line);color:var(--txt);
    border-radius:6px;padding:6px 12px;cursor:pointer;font-size:13px}
  button:hover{border-color:var(--accent)}
  .filters{display:flex;flex-wrap:wrap;gap:6px;margin-top:10px}
  .filters button.active{background:var(--accent);border-color:var(--accent);color:#1a1008;font-weight:600}
  main{padding:18px}
  .cat{margin-bottom:26px}
  .cat h2{font-size:16px;border-left:4px solid var(--accent);padding-left:10px;margin:0 0 12px;
    display:flex;align-items:center;gap:10px}
  .cat .cprog{font-size:12px;color:var(--sub);font-weight:400}
  .weapon{background:var(--panel);border:1px solid var(--line);border-radius:10px;margin-bottom:14px;overflow:hidden}
  .whead{display:flex;align-items:center;gap:12px;padding:12px 14px;cursor:pointer;
    background:var(--panel2);border-bottom:1px solid var(--line)}
  .whead .wname{font-size:15px;font-weight:600}
  .whead .wlvl{font-size:11px;color:var(--sub);background:var(--chip);padding:2px 8px;border-radius:20px}
  .whead .wprog{margin-left:auto;font-size:12px;color:var(--sub)}
  .whead .wmini{width:120px;height:8px;background:var(--bg);border-radius:6px;overflow:hidden;border:1px solid var(--line)}
  .whead .wmini i{display:block;height:100%;background:var(--ok);width:0;transition:width .2s}
  table{width:100%;border-collapse:collapse}
  th,td{text-align:left;padding:8px 10px;border-bottom:1px solid var(--line);vertical-align:top}
  th{font-size:11px;color:var(--sub);font-weight:600;text-transform:uppercase;letter-spacing:.3px}
  td.ck{width:34px;text-align:center}
  td.ck input{width:18px;height:18px;cursor:pointer;accent-color:var(--ok)}
  .camo{font-weight:600}
  .tier-M{color:#9aa7b3}.tier-S{color:var(--accent2)}.tier-G{color:#ffd23f}
  .tier-P{color:#b07cff}.tier-H{color:#2fd6c6}.tier-D{color:#ff5d8f}
  .pill{display:inline-block;font-size:10px;padding:1px 7px;border-radius:20px;margin-right:6px;vertical-align:middle}
  .pill.mp{background:#173a2e;color:#5fe39b;border:1px solid #1f5e44}
  .pill.dmz{background:#3a2a12;color:var(--dmz);border:1px solid #6b4a16}
  .cond{font-size:12px;color:var(--sub)}
  .cond.dmz{color:var(--dmz)}
  .warn{color:var(--warn);font-size:11px}
  .row-special{background:rgba(78,161,255,.04)}
  .row-comp{background:rgba(255,122,69,.03)}
  .done td.camo{text-decoration:line-through;opacity:.6}
  .mastery{background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:14px;margin-top:8px}
  .mastery h3{margin:0 0 10px;font-size:14px;color:var(--accent)}
  .mlist{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:10px}
  .mcard{border:1px solid var(--line);border-radius:8px;padding:10px;background:var(--panel2)}
  .mcard .mt{font-weight:600;margin-bottom:4px}
  .mcard .md{font-size:12px;color:var(--sub)}
  footer{color:var(--sub);font-size:11px;padding:20px 18px;border-top:1px solid var(--line)}
  details summary{cursor:pointer;outline:none}
  .legend{display:flex;gap:14px;flex-wrap:wrap;font-size:11px;color:var(--sub);margin-top:8px}
  .legend span b{color:var(--txt)}
  .saved{font-size:12px;color:var(--ok);opacity:0;transition:opacity .3s;align-self:center}
  .saved.show{opacity:1}
  .memnote{font-size:11px;color:var(--sub);margin-left:auto;align-self:center}
  .memnote b{color:var(--accent2)}
</style>
</head>
