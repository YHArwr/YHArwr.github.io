/* 全局大师迷彩（非每把枪，三条独立线） */
const MASTERY = [
 {line:"多人 MP",items:[
   {n:"Mercurial Drift",d:"单局 10 杀 ×250 次"},
   {n:"Polyatomic Reforged",d:"无伤 3 杀连击 ×300 次"},
   {n:"Orion Reforged",d:"不死 5 杀 ×500 次（终极大师）"}]},
 {line:"僵尸/DMZ",items:[
   {n:"Chiral",d:"Tier 3+ 敌人击杀 2,500"},
   {n:"Ripple Tide",d:"单次部署带 2 个中尉狗牌撤离 ×50"},
   {n:"Helio",d:"满级特工用传说武器击杀（⚠️ 数值冲突：2.5万 / 25万，以游戏内为准）"}]},
 {line:"战区 Warzone（第1赛季）",items:[
   {n:"Parallax",d:"挑战要求官方未公布"},
   {n:"Damascus Reforged",d:"挑战要求官方未公布"},
   {n:"Empyros",d:"挑战要求官方未公布"}]}
];

/* ===== 渲染 ===== */
const STORE_KEY = "mw4camo_v1";
let state = loadState();

function loadState(){
  try{ const s=localStorage.getItem(STORE_KEY); return s?JSON.parse(s):{}; }catch(e){ return {}; }
}
let lastSaveOK = true;
function safeSet(v){ try{ localStorage.setItem(STORE_KEY, v); return true; }catch(e){ return false; } }
function showSaved(){
  const el=document.getElementById("saved");
  if(!el) return;
  el.textContent = lastSaveOK
    ? ("✓ 已保存 "+new Date().toLocaleTimeString("zh-CN"))
    : "⚠️ 当前环境禁止本地保存，进度仅本次会话有效（可用「导出进度」备份）";
  el.classList.add("show");
  clearTimeout(showSaved._t);
  showSaved._t=setTimeout(()=>el.classList.remove("show"),2200);
}
function saveState(){ lastSaveOK = safeSet(JSON.stringify(state)); showSaved(); }
function key(w,n){ return w+"::"+n; }
function isDone(w,n){ return !!state[key(w,n)]; }
// 先更新界面，再尝试存盘：即使存储被禁用，勾选与进度也实时生效
function toggle(w,n){ const k=key(w,n); state[k]=!state[k]; updateProgress(); saveState(); }

const CATS = [...new Set(WEAPONS.map(w=>w.cat))];
const main = document.getElementById("main");

function buildWeapon(w){
  const comp = CAT_COMP[w.cat];
  // 8 个勾选项：M + 3S + G + P + H + D
  const rows = [];
  rows.push({id:"M",tier:"M",label:"军事迷彩(满级)",cls:"",
    mp:"武器升到满级自动解锁 8 个军事迷彩",dmz:"同左（满级即解锁）"});
  w.s.forEach((c,i)=>{
    rows.push({id:"S"+(i+1),tier:"S",label:(c.cn?c.cn+" ":"")+c.n,cls:"row-special",mp:c.mp,dmz:c.dmz,dmzWarn:c.dmzWarn});
  });
  rows.push({id:"G",tier:"G",label:"金 Gold",cls:"row-comp",mp:comp.gold.mp,dmz:comp.gold.dmz});
  rows.push({id:"P",tier:"P",label:"铂金 Platinum",cls:"row-comp",
    mp:comp.plat.mp+"（需同类全金）",dmz:comp.plat.dmz+"（需同类全金）"});
  rows.push({id:"H",tier:"H",label:"谐波破碎 Harmonic Break",cls:"row-comp",
    mp:comp.hb.mp+"（需全游戏 33 铂金）",dmz:comp.hb.dmz+"（需全游戏 33 铂金）"});
  rows.push({id:"D",tier:"D",label:"分歧 Divergence",cls:"row-comp",
    mp:"完成 33 个 Harmonic Break 后自动解锁",dmz:"同左（无专属挑战）"});

  const total = rows.length;
  const done = rows.filter(r=>isDone(w.name,r.id)).length;
  const pct = Math.round(done/total*100);

  let html = `<details class="weapon" data-cat="${w.cat}" data-name="${w.name}">
    <summary class="whead">
      <span class="wname">${w.cn?w.cn+" ":""}${w.name}</span>
      <span class="wlvl">解锁 Lv.${w.lvl}</span>
      <span class="wmini"><i style="width:${pct}%"></i></span>
      <span class="wprog">${done}/${total} · ${pct}%</span>
    </summary>
    <table>
      <thead><tr><th class="ck">✓</th><th>迷彩</th><th><span class="pill mp">MP</span> 多人条件</th><th><span class="pill dmz">DMZ</span> 僵尸条件</th></tr></thead>
      <tbody>`;
  rows.forEach(r=>{
    const d = isDone(w.name,r.id);
    const dmzWarn = r.dmzWarn ? ' <span class="warn">⚠️</span>' : '';
    html += `<tr class="${r.cls} ${d?'done':''}" data-r="${r.id}">
      <td class="ck"><input type="checkbox" ${d?'checked':''} onchange="toggle('${w.name}','${r.id}')"></td>
      <td class="camo tier-${r.tier}">${r.label}</td>
      <td class="cond">${r.mp}</td>
      <td class="cond dmz">${r.dmz}${dmzWarn}</td>
    </tr>`;
  });
  html += `</tbody></table></details>`;
  return html;
}

function buildMastery(){
  let html = `<div class="cat"><h2>全局大师迷彩 Mastery（非每把枪）</h2><div class="mastery"><div class="mlist">`;
  MASTERY.forEach(line=>{
    line.items.forEach(it=>{
      const d = isDone("MASTERY",it.n);
      html += `<div class="mcard ${d?'done':''}">
        <label style="display:flex;gap:8px;align-items:flex-start;cursor:pointer">
          <input type="checkbox" ${d?'checked':''} onchange="toggle('MASTERY','${it.n}')" style="margin-top:3px;accent-color:var(--ok)">
          <span><span class="mt">${it.n}</span><br><span class="md">[${line.line}] ${it.d}</span></span>
        </label></div>`;
    });
  });
  html += `</div></div></div>`;
  return html;
}

function render(){
  let html = "";
  CATS.forEach(cat=>{
    const ws = WEAPONS.filter(w=>w.cat===cat);
    const all = ws.flatMap(w=>{
      const comp=CAT_COMP[w.cat];
      const ids=["M","S1","S2","S3","G","P","H","D"];
      return ids.map(id=>isDone(w.name,id));
    });
    const done = all.filter(Boolean).length;
    const pct = Math.round(done/all.length*100);
    html += `<div class="cat" data-cat="${cat}"><h2>${cat} <span class="cprog">${done}/${all.length} · ${pct}%</span></h2>`;
    ws.forEach(w=> html += buildWeapon(w));
    html += `</div>`;
  });
  html += buildMastery();
  main.innerHTML = html;
  applyFilter();
}

function updateProgress(){
  // 重新计算所有进度（包含顶部总进度 + 各武器/类别），不整体重渲染以保持展开状态
  const allIds = [];
  WEAPONS.forEach(w=>["M","S1","S2","S3","G","P","H","D"].forEach(id=>allIds.push([w.name,id])));
  MASTERY.forEach(l=>l.items.forEach(it=>allIds.push(["MASTERY",it.n])));
  const done = allIds.filter(([w,n])=>isDone(w,n)).length;
  const total = allIds.length;
  const pct = Math.round(done/total*100);
  const bar=document.getElementById("bar"); if(bar) bar.style.width = pct+"%";
  const bl=document.getElementById("barlabel"); if(bl) bl.textContent = `${done} / ${total} · ${pct}%`;
  // 更新各武器迷你条与类别进度
  document.querySelectorAll("details.weapon").forEach(det=>{
    const wname = det.dataset.name;
    const ids=["M","S1","S2","S3","G","P","H","D"];
    const wd = ids.filter(id=>isDone(wname,id)).length;
    const wp = Math.round(wd/ids.length*100);
    det.querySelector(".wmini i").style.width = wp+"%";
    det.querySelector(".wprog").textContent = `${wd}/${ids.length} · ${wp}%`;
  });
  document.querySelectorAll(".cat[data-cat]").forEach(catEl=>{
    const cat = catEl.dataset.cat;
    const ws = WEAPONS.filter(w=>w.cat===cat);
    let d=0,t=0;
    ws.forEach(w=>["M","S1","S2","S3","G","P","H","D"].forEach(id=>{t++;if(isDone(w.name,id))d++;}));
    const cp=Math.round(d/t*100);
    const el=catEl.querySelector(".cprog"); if(el) el.textContent=`${d}/${t} · ${cp}%`;
  });
}

/* 筛选 */
function applyFilter(){
  const q = document.getElementById("search").value.trim().toLowerCase();
  const active = document.querySelector(".filters button.active");
  const catf = active ? active.dataset.cat : "全部";
  document.querySelectorAll("details.weapon").forEach(det=>{
    const name = det.dataset.name.toLowerCase();
    const cat = det.dataset.cat;
    const matchCat = (catf==="全部"||cat===catf);
    const matchQ = (!q || name.includes(q));
    det.style.display = (matchCat&&matchQ) ? "" : "none";
  });
}

function buildFilters(){
  const f = document.getElementById("filters");
  const all = ["全部",...CATS];
  f.innerHTML = all.map(c=>`<button data-cat="${c}" class="${c==='全部'?'active':''}">${c}</button>`).join("");
  f.querySelectorAll("button").forEach(b=>b.onclick=()=>{
    f.querySelectorAll("button").forEach(x=>x.classList.remove("active"));
    b.classList.add("active"); applyFilter();
  });
}

/* 事件 */
document.getElementById("search").addEventListener("input",applyFilter);
document.getElementById("expandAll").onclick=()=>document.querySelectorAll("details.weapon").forEach(d=>d.open=true);
document.getElementById("collapseAll").onclick=()=>document.querySelectorAll("details.weapon").forEach(d=>d.open=false);
document.getElementById("resetBtn").onclick=()=>{
  if(confirm("确定清空本浏览器保存的全部勾选进度？此操作不可撤销。")){
    state={}; saveState(); render(); updateProgress();
  }
};
document.getElementById("exportBtn").onclick=()=>{
  const blob=new Blob([JSON.stringify(state,null,2)],{type:"application/json"});
  const a=document.createElement("a"); a.href=URL.createObjectURL(blob);
  a.download="mw4-camo-progress.json"; a.click();
};
document.getElementById("importBtn").onclick=()=>document.getElementById("importFile").click();
document.getElementById("importFile").onchange=e=>{
  const f=e.target.files[0]; if(!f)return;
  const r=new FileReader(); r.onload=()=>{ try{ state=JSON.parse(r.result); saveState(); render(); updateProgress(); alert("导入成功"); }catch(err){ alert("文件格式错误"); } };
  r.readAsText(f);
};

/* 初始化 */
buildFilters();
render();
updateProgress();
</script>
